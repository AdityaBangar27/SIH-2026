<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flashcardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/customBackgroundColor">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/flashcardTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnFlashcardBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/customPrimaryColor" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/flashcards_title"
            android:textColor="?attr/customTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Flashcard (Centered Large Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFlashcardMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/customCardColor"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toTopOf="@+id/flashcardControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashcardTopBar"
        app:strokeColor="?attr/customBorderColor"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Big Apple Visual -->
            <ImageView
                android:id="@+id/ivFlashcardVisual"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="Flashcard illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_apple_single" />

            <!-- Hindi Word: सेब -->
            <TextView
                android:id="@+id/tvFlashcardHindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/flashcard_hindi_word"
                android:textColor="?attr/customTextColor"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Transliteration: (Seb) -->
            <TextView
                android:id="@+id/tvFlashcardTransliteration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/flashcard_transliteration"
                android:textColor="?attr/customTextSecondaryColor"
                android:textSize="14sp" />

            <!-- English Equivalent: Apple -->
            <TextView
                android:id="@+id/tvFlashcardEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/flashcard_english_word"
                android:textColor="?attr/customTextSecondaryColor"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Mother Tongue Translation (revealed on tap): ᱟᱯᱮᱞ (Apel) -->
            <TextView
                android:id="@+id/tvFlashcardMotherTongue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_secondary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="@string/flashcard_santhali_word"
                android:textColor="?attr/customPrimaryColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Speaker Audio Button -->
            <ImageView
                android:id="@+id/btnFlashcardAudio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play pronunciation"
                android:padding="8dp"
                android:src="@drawable/ic_speaker"
                app:tint="?attr/customPrimaryColor" />

            <!-- Tap Hint -->
            <TextView
                android:id="@+id/tvTapHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tap_to_reveal"
                android:textColor="?attr/customTextSecondaryColor"
                android:textSize="11sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Navigation Controls: <  1/10  > -->
    <LinearLayout
        android:id="@+id/flashcardControls"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Previous Arrow Circle Button -->
        <ImageView
            android:id="@+id/btnPrevCard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:contentDescription="Previous Card"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/customPrimaryColor" />

        <!-- Counter 1/10 -->
        <TextView
            android:id="@+id/tvCardCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="@string/flashcard_counter_sample"
            android:textColor="?attr/customTextColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Next Arrow Circle Button -->
        <ImageView
            android:id="@+id/btnNextCard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:contentDescription="Next Card"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="?attr/customPrimaryColor" />

    </LinearLayout>

    <!-- Empty State View when no flashcards exist -->
    <LinearLayout
        android:id="@+id/layoutEmptyFlashcards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashcardTopBar">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="No flashcards"
            android:src="@drawable/ic_language"
            app:tint="?attr/customTextSecondaryColor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/empty_flashcards_title"
            android:textColor="?attr/customTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_flashcards_desc"
            android:textColor="?attr/customTextSecondaryColor"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
