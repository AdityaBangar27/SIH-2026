<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/customBackgroundColor">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/lessonTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnLessonBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/customPrimaryColor" />

        <TextView
            android:id="@+id/tvLessonSubjectHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/lesson_title_math"
            android:textColor="?attr/customTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollLessonContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/lessonBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lessonTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Lesson Header Row: Chapter + Badge -->
            <TextView
                android:id="@+id/tvLessonChapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lesson_chapter_numbers"
                android:textColor="?attr/customTextColor"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLessonProgressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/lesson_progress_1_5"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Big Lesson Interactive Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLessonContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Illustration of 3 Apples -->
                    <ImageView
                        android:id="@+id/ivLessonVisual"
                        android:layout_width="220dp"
                        android:layout_height="90dp"
                        android:contentDescription="Counting visual"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_apples_three" />

                    <!-- Digits 1 2 3 -->
                    <TextView
                        android:id="@+id/tvLessonNumbers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.4"
                        android:text="1   2   3"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Bilingual Hindi Pronunciation -->
                    <TextView
                        android:id="@+id/tvLessonHindi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/lesson_hindi_numbers"
                        android:textColor="?attr/customTextColor"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Mother Tongue Santhali / Mundari / Ho Translation -->
                    <TextView
                        android:id="@+id/tvLessonVernacular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lesson_santhali_numbers"
                        android:textColor="?attr/customTextSecondaryColor"
                        android:textSize="14sp" />

                    <!-- Speaker audio control -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPlayLessonAudio"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/customCardTintColor"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/customBorderColor"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Pronounce audio"
                            android:src="@drawable/ic_speaker"
                            app:tint="?attr/customPrimaryColor" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Instructional Guide Text -->
            <TextView
                android:id="@+id/tvLessonInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lesson_counting_instructions"
                android:textColor="?attr/customTextSecondaryColor"
                android:textSize="13sp" />

            <!-- Previous and Next Navigation Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Previous Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreviousLesson"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_previous"
                    android:textAllCaps="false"
                    android:textColor="?attr/customPrimaryColor"
                    android:textSize="14sp"
                    app:cornerRadius="24dp"
                    app:strokeColor="?attr/customPrimaryColor"
                    app:strokeWidth="1.5dp" />

                <!-- Next Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextLesson"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/customPrimaryColor"
                    android:text="@string/btn_next"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Empty State View when no lessons exist -->
    <LinearLayout
        android:id="@+id/layoutEmptyLessons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/lessonBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lessonTopBar">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="No lessons"
            android:src="@drawable/ic_lessons"
            app:tint="?attr/customTextSecondaryColor" />

        <TextView
            android:id="@+id/tvEmptyLessonsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/empty_lessons_title"
            android:textColor="?attr/customTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyLessonsDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_lessons_desc"
            android:textColor="?attr/customTextSecondaryColor"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Return to Lessons Footer -->
    <LinearLayout
        android:id="@+id/lessonBottomNav"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/customCardTintColor"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvBackToLessons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back_to_lessons"
            android:textColor="?attr/customPrimaryColor"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
