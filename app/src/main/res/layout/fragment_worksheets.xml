<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/customBackgroundColor">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/worksheetsTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnWorksheetsBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/customPrimaryColor" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/worksheets_and_flashcards"
            android:textColor="?attr/customTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Segmented Tab Bar (Worksheets | Flashcards) -->
    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="260dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_tab_container"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/worksheetsTopBar">

        <!-- Tab 1: Worksheets -->
        <TextView
            android:id="@+id/tabWorksheets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_worksheets"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tab 2: Flashcards -->
        <TextView
            android:id="@+id/tabFlashcards"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/tab_flashcards"
            android:textColor="?attr/customTextSecondaryColor"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Worksheets Content List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorksheets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabContainer"
        tools:listitem="@layout/item_worksheet_card" />

    <!-- Flashcards Container (Toggled via tab) -->
    <FrameLayout
        android:id="@+id/flashcardTabContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
