<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Class"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnDeckClass"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Subject"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnDeckSubject"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select Topic"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnDeckTopic"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Number of Cards"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnDeckCards"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected" />

</LinearLayout>
