<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/customBackgroundColor">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/vtTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVtBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/customPrimaryColor" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/voice_translation_title"
            android:textColor="?attr/customTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Offline AI"
            android:textColor="?attr/customPrimaryColor"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vtTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- Interactive Translation Direction Banner & Swap Control -->
            <LinearLayout
                android:id="@+id/bannerDirectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_secondary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDirectionInputText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teacher • Hindi (हिंदी)"
                        android:textColor="?attr/customTextColor"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDirectionArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="➔"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDirectionOutputText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student • Santali (संथाली)"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Direction Swap Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSwapDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/customPrimaryColor"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Swap Direction"
                            android:src="@drawable/ic_swap"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="बदलें"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ============================================================== -->
            <!-- 1. TEACHER SECTION (Speech & Recognition Input)                 -->
            <!-- ============================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTeacherPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Panel Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTeacherPanelTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Teacher (शिक्षक) • Hindi"
                            android:textColor="?attr/customTextColor"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeTeacherState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_accent"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Ready"
                            android:textColor="?attr/customPrimaryColor"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Teacher Microphone Control -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <FrameLayout
                            android:layout_width="76dp"
                            android:layout_height="76dp">

                            <!-- Pulse Ripple View -->
                            <View
                                android:id="@+id/viewTeacherRipple"
                                android:layout_width="76dp"
                                android:layout_height="76dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_mic_ripple"
                                android:visibility="invisible" />

                            <!-- Single Role Control Button -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnTeacherControl"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="center"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="?attr/customPrimaryColor"
                                app:cardCornerRadius="28dp"
                                app:cardElevation="3dp"
                                app:strokeColor="@android:color/transparent">

                                <ImageView
                                    android:id="@+id/ivTeacherControlIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Teacher Microphone"
                                    android:src="@drawable/ic_mic"
                                    app:tint="@color/white" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <!-- Teacher Status Text -->
                        <TextView
                            android:id="@+id/tvTeacherStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/tap_to_speak_hindi"
                            android:textColor="?attr/customTextColor"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Recognized Hindi Text Box -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:cardBackgroundColor="?attr/customCardTintColor"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/customBorderColor"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvTeacherInputLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_recognized_hindi"
                                android:textColor="?attr/customTextSecondaryColor"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/tvTeacherRecognized"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@null"
                                android:hint="@string/placeholder_awaiting_speech"
                                android:textColor="?attr/customTextColor"
                                android:textColorHint="?attr/customTextSecondaryColor"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- TRANSLATE Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTranslate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="?attr/customPrimaryColor"
                        android:text="TRANSLATE"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="22dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Flow Divider Indicator: Hindi → Santali -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"
                    android:background="?attr/customBorderColor" />

                <TextView
                    android:id="@+id/tvFlowDividerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/bg_pill_accent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/direction_hindi_to_santali"
                    android:textColor="?attr/customPrimaryColor"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_weight="1"
                    android:background="?attr/customBorderColor" />
            </LinearLayout>

            <!-- ============================================================== -->
            <!-- 2. STUDENT SECTION (Santali Translation & Audio Playback)      -->
            <!-- ============================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudentPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Panel Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStudentPanelTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Student (छात्र) • Santali"
                            android:textColor="?attr/customTextColor"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeStudentState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_accent"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Ready"
                            android:textColor="?attr/customPrimaryColor"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Translated Santali Text Box -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="?attr/customCardTintColor"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/customBorderColor"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvStudentOutputLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_translation_santhali"
                                android:textColor="?attr/customPrimaryColor"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStudentTranslated"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/noto_sans_ol_chiki"
                                android:hint="@string/placeholder_awaiting_translation"
                                android:textColor="?attr/customTextColor"
                                android:textColorHint="?attr/customTextSecondaryColor"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Santali Speech Action & Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnPlaySantali"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/customPrimaryColor"
                            app:cardCornerRadius="19dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@android:color/transparent">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp">

                                <ImageView
                                    android:id="@+id/ivPlaySantaliIcon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:contentDescription="Play Icon"
                                    android:src="@drawable/ic_speaker"
                                    app:tint="@color/white" />

                                <TextView
                                    android:id="@+id/tvPlaySantaliLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/btn_play_santali"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvStudentStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/noto_sans_ol_chiki"
                            android:text="@string/placeholder_awaiting_translation"
                            android:textColor="?attr/customTextSecondaryColor"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Engine Pipeline Status -->
            <TextView
                android:id="@+id/tvEngineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:text="@string/status_ready"
                android:textColor="?attr/customTextSecondaryColor"
                android:textSize="12sp" />

            <!-- TRANSLATION PERFORMANCE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPerformance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <!-- Header: TRANSLATION PERFORMANCE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="TRANSLATION PERFORMANCE"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Main Elapsed Time Value: e.g. 2.84 s -->
                    <TextView
                        android:id="@+id/tvPerformanceTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="--.-- s"
                        android:textColor="?attr/customTextColor"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Description / Status -->
                    <TextView
                        android:id="@+id/tvPerformanceDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Time will appear after translation"
                        android:textColor="?attr/customTextSecondaryColor"
                        android:textSize="12sp" />

                    <!-- Breakdown (ASR, Translation, Total) -->
                    <TextView
                        android:id="@+id/tvPerformanceBreakdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/customTextSecondaryColor"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <!-- Recent Performance History (last 3 times) -->
                    <TextView
                        android:id="@+id/tvPerformanceHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/customTextSecondaryColor"
                        android:textSize="10sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
