<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="सामग्री का नाम *"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etResourceName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected"
        android:hint="उदा. पौधों के नोट्स.pdf"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="कक्षा"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnResourceClass"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="विषय"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnResourceSubject"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="अध्याय / पाठ"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etResourceTopic"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected"
        android:hint="उदा. हमारे आसपास के पौधे"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="भाषा"
        android:textColor="?attr/customTextColor"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnResourceLanguage"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_unselected" />

</LinearLayout>
