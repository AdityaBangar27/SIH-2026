<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/customBackgroundColor"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/customCardColor"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            app:tint="?attr/customTextColor" />

        <TextView
            android:id="@+id/tvTopBarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBack"
            android:text="अध्ययन सामग्री"
            android:textColor="?attr/customTextColor"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_tab_unselected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="कक्षा 3 • EVS"
            android:textColor="?attr/customPrimaryColor"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <!-- Title & Subtitle -->
            <TextView
                android:id="@+id/tvTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="हमारे आसपास के पौधे"
                android:textColor="?attr/customTextColor"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopicSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="अध्याय 1 • पर्यावरण अध्ययन • कक्षा 3"
                android:textColor="?attr/customPrimaryColor"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Action Buttons Row (Top Quick Launch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickWorksheet"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/customPrimaryColor"
                    android:text="अभ्यास पत्रक"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_nav_pencil"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickFlashcards"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/customCardTintColor"
                    android:text="फ्लैशकार्ड"
                    android:textAllCaps="false"
                    android:textColor="?attr/customPrimaryColor"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_apple_single"
                    app:iconSize="16dp"
                    app:iconTint="?attr/customPrimaryColor"
                    app:strokeColor="?attr/customPrimaryColor"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- 1. Learning Objective Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="🎯 सीखने का उद्देश्य (Learning Objective)"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLearningObjective"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="बच्चे पौधों के विभिन्न भागों को पहचानेंगे और उनके महत्व को समझेंगे।"
                        android:textColor="?attr/customTextColor"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Key Concepts / Study Material Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="🌱 मुख्य बिंदु और अध्ययन सामग्री"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Dynamic container for parts -->
                    <LinearLayout
                        android:id="@+id/layoutKeyConceptsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. What We Learn / Explanation Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="📖 समझें (Explanation)"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="पौधे सजीव होते हैं। उन्हें बढ़ने के लिए पानी, धूप और हवा की आवश्यकता होती है।"
                        android:textColor="?attr/customTextColor"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Key Points Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="💡 मुख्य बिंदु (Key Points)"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutKeyPointsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Examples Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="🌿 उदाहरण (Examples)"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutExamplesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. Bilingual Vocabulary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="🗣️ शब्दावली (Vocabulary: हिन्दी / ᱥᱟᱱᱛᱟᱲᱤ)"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutVocabularyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7. Quick Check Questions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="?attr/customCardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/customBorderColor"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="❓ अभ्यास प्रश्न (Practice Questions)"
                        android:textColor="?attr/customPrimaryColor"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutQuickCheckContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Action Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewWorksheetBottom"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="?attr/customPrimaryColor"
                    android:text="अभ्यास पत्रक खोलें"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_nav_pencil" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPracticeFlashcardsBottom"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="?attr/customCardTintColor"
                    android:text="फ्लैशकार्ड अभ्यास करें"
                    android:textAllCaps="false"
                    android:textColor="?attr/customPrimaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_apple_single"
                    app:iconTint="?attr/customPrimaryColor"
                    app:strokeColor="?attr/customPrimaryColor"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
