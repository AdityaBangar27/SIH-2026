<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDownloadRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/customCardColor"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/customBorderColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Category Icon -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_secondary">

                <ImageView
                    android:id="@+id/ivDownloadTypeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Package Icon"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/customPrimaryColor" />
            </FrameLayout>

            <!-- Name and Size -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDownloadTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pkg_lesson_packages"
                    android:textColor="?attr/customTextColor"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDownloadSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pkg_lesson_size"
                    android:textColor="?attr/customTextSecondaryColor"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action Button: Download / Remove / Retry -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadAction"
                android:layout_width="100dp"
                android:layout_height="38dp"
                android:backgroundTint="?attr/customPrimaryColor"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_download"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="19dp" />

        </LinearLayout>

        <!-- Progress Bar for Downloading State -->
        <ProgressBar
            android:id="@+id/pbDownloadItem"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:progress="0"
            android:progressTint="?attr/customPrimaryColor"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
