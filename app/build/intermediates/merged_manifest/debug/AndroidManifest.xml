<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vernacular.learning"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="com.vernacular.learning.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.vernacular.learning.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.vernacular.learning.VernacularApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_vaani_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_vaani_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.VernacularLearning" >

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name="com.vernacular.learning.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.VernacularLearning.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Hub Activity (Houses Bottom Nav & Core Fragments) -->
        <activity
            android:name="com.vernacular.learning.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />

        <!-- Lesson Interactive Screen -->
        <activity
            android:name="com.vernacular.learning.ui.lesson.LessonActivity"
            android:exported="false"
            android:parentActivityName="com.vernacular.learning.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Dedicated Flashcards Screen -->
        <activity
            android:name="com.vernacular.learning.ui.flashcards.FlashcardActivity"
            android:exported="false"
            android:parentActivityName="com.vernacular.learning.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Theme Selection Screen -->
        <activity
            android:name="com.vernacular.learning.ui.settings.ThemeSettingsActivity"
            android:exported="false"
            android:parentActivityName="com.vernacular.learning.MainActivity"
            android:screenOrientation="portrait" />

        <!-- Download Content Manager Screen -->
        <activity
            android:name="com.vernacular.learning.ui.downloads.DownloadContentActivity"
            android:exported="false"
            android:parentActivityName="com.vernacular.learning.MainActivity"
            android:screenOrientation="portrait" />

        <!-- About App & SIH 2026 Info Screen -->
        <activity
            android:name="com.vernacular.learning.ui.about.AboutActivity"
            android:exported="false"
            android:parentActivityName="com.vernacular.learning.MainActivity"
            android:screenOrientation="portrait" />

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.vernacular.learning.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>