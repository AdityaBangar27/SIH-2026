<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMaterialItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/customCardColor"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/customBorderColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Icon Container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_secondary">

            <ImageView
                android:id="@+id/ivMaterialIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Material icon"
                android:src="@drawable/ic_lessons"
                app:tint="?attr/customPrimaryColor" />
        </FrameLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMaterialTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Numbers and Counting Package"
                android:textColor="?attr/customTextColor"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMaterialSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Class 1 • Mathematics • Santhali"
                android:textColor="?attr/customTextSecondaryColor"
                android:textSize="12sp" />

            <!-- Offline Badge / Download Status -->
            <TextView
                android:id="@+id/tvMaterialStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_secondary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/offline_badge"
                android:textColor="?attr/customPrimaryColor"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Chevron or Download indicator -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="Open material"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/customTextSecondaryColor" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
